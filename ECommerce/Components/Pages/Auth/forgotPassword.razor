@page "/forgot-password"

<div class="container myContain">
    <div class="row">

        <div class="forgot-password">
            <span>Forgot your</span><br>
            <span>password?</span>
        </div>

        <div class="inputMain">
            <h6 class="text-right">Account email address</h6>
            <input type="email" placeholder="your-sign-up-email@example.com" class="form-control" />
        </div>

        <div class="submitBtn">
            <button class="btn sign-in-btn btn-primary" type="submit">
                Request password reset
            </button>
        </div>

        <div class="backPage">
            <a href="">Back to login</a>
        </div>

    </div>
</div>
