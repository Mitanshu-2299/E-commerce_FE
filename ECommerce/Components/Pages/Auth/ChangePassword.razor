@page "/change-password"

<h3>Change Password</h3>

<div class="container">
    <div class="change-password-section">

        <form>

           
            <div class="form-group">
                <label>Email</label>
                <input class="form-control" type="email" placeholder="Enter your email" />
            </div>

        
            <div class="form-group">
                <label>Current Password</label>
                <input class="form-control" type="password" placeholder="Enter current password" />
            </div>

           
            <div class="form-group">
                <label>New Password</label>
                <input class="form-control" type="password" placeholder="Enter new password" />
            </div>

            <div class="form-group">
                <label>Confirm New Password</label>
                <input class="form-control" type="password" placeholder="Confirm new password" />
            </div>

        
            <button class="btn btn-primary mt-3" type="submit">
                Change Password
            </button>

   
            <div class="alert alert-success mt-2 d-none" id="feedbackMessage">
                Password successfully changed!
            </div>

        </form>

    </div>
</div>
