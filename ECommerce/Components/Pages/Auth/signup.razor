
@page "/signup"
@using ECommerce.Model.Signup
@using Microsoft.AspNetCore.Components.Forms
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@using ECommerce.Config
@using ECommerce.Service.API
@using ECommerce.Service.CountryService
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject ICountryService CountryService

<div class="signup-container">
    <div class="signup-card">

        <!-- LEFT SIDE: Form -->
        <div class="signup-form">
            <h2>Create an account</h2>

            <EditForm Model="signupModel" OnValidSubmit="HandleSignup">
                <DataAnnotationsValidator />

                <!-- Name / Email -->
                <div class="form-row">
                    <div class="form-group">
                        <label>Name</label>
                        <InputText @bind-Value="signupModel.Name" class="form-control" placeholder="Enter name" />
                        <ValidationMessage For="@(() => signupModel.Name)" />
                    </div>
                    <div class="form-group">
                        <label>Email</label>
                        <InputText @bind-Value="signupModel.Email" type="email" class="form-control" placeholder="Enter email" />
                        <ValidationMessage For="@(() => signupModel.Email)" />
                    </div>
                </div>

                <!-- Password / Confirm -->
                <div class="form-row">
                    <div class="form-group">
                        <label>Password</label>
                        <InputText @bind-Value="signupModel.Password" type="password" class="form-control" placeholder="Enter password" />
                        <ValidationMessage For="@(() => signupModel.Password)" />
                    </div>
                    <div class="form-group">
                        <label>Confirm Password</label>
                        <InputText @bind-Value="confirmPassword" type="password" class="form-control" placeholder="Confirm password" />
                    </div>
                </div>

                <!-- Phone / Gender -->
                <div class="form-row">
                    <div class="form-group">
                        <label>Phone Number</label>
                        <InputText @bind-Value="signupModel.Phone_Number" type="tel" class="form-control" placeholder="Enter phone number" />
                        <ValidationMessage For="@(() => signupModel.Phone_Number)" />
                    </div>
                    <div class="form-group">
                        <label>Gender</label>
                        <InputSelect @bind-Value="signupModel.Gender" class="form-control">
                            <option value="">Select gender</option>
                            <option value="male">Male</option>
                            <option value="female">Female</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => signupModel.Gender)" />
                    </div>
                </div>

                <!-- Profile Image -->
                <div class="form-group">
                    <label>Profile Image</label>
                    <InputFile OnChange="HandleFileSelected" />
                </div>

                <h4>Address Details</h4>

                <!-- Country / State -->
                <div class="form-row">
                    <div class="form-group">
                        <label>Country</label>
                        <InputSelect @bind-Value="signupModel.Address.Country_Id" class="form-control" @onchange="OnCountryChanged">
                            <option value="">-- Select Country --</option>
                            @foreach (var country in countries)
                            {
                                <option value="@country.Id">@country.Name</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="form-group">
                        <label>State</label>
                        <InputSelect @bind-Value="signupModel.Address.State_Id" class="form-control" @onchange="OnStateChanged" disabled="@(!states.Any())">
                            <option value="">-- Select State --</option>
                            @foreach (var state in states)
                            {
                                <option value="@state.Id">@state.Name</option>
                            }
                        </InputSelect>
                    </div>
                </div>

                <!-- City / Postal -->
                <div class="form-row">
                    <div class="form-group">
                        <label>City</label>
                        <InputSelect @bind-Value="signupModel.Address.City_Id" class="form-control" disabled="@(!cities.Any())">
                            <option value="">-- Select City --</option>
                            @foreach (var city in cities)
                            {
                                <option value="@city.Id">@city.Name</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="form-group">
                        <label>Postal Code</label>
                        <InputNumber @bind-Value="signupModel.Address.Postal_Code" class="form-control" />
                    </div>
                </div>

                <!-- Address Type / Address Line 1 -->
                <div class="form-row">
                    <div class="form-group">
                        <label>Address Type</label>
                        <InputText @bind-Value="signupModel.Address.Label" class="form-control" placeholder="Home / Office" />
                    </div>
                    <div class="form-group">
                        <label>Address Line 1</label>
                        <InputText @bind-Value="signupModel.Address.Address_Line1" class="form-control" placeholder="Enter address line 1" />
                    </div>
                </div>

                <!-- Address Line 2 -->
                <div class="form-group">
                    <label>Address Line 2</label>
                    <InputText @bind-Value="signupModel.Address.Address_Line2" class="form-control" placeholder="Enter address line 2" />
                </div>

                <!-- Submit -->
                <button type="submit" class="btn-submit">Sign up</button>
            </EditForm>

            <div class="mt-3 text-center">
                Already have an account? <NavLink href="/login">Sign in</NavLink>
            </div>
        </div>

        <!-- RIGHT SIDE: Image -->
        <div class="signup-image">
            <img src="/images/signUpImage.jpg" alt="Signup illustration" />
        </div>
    </div>
</div>
@code {
    private SignupRequest signupModel = new()
        {
            Address = new AddressRequest()
        };

    private string confirmPassword;
    private IBrowserFile selectedFile;

    private List<LocationModel> countries = new();
    private List<LocationModel> states = new();
    private List<LocationModel> cities = new();

    // ✅ Updated OnInitializedAsync
    protected override async Task OnInitializedAsync()
    {
        try
        {
            countries = await CountryService.GetCountriesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error fetching countries: " + ex.Message);
        }
    }

    // DTOs for API mapping
    public class StateModel
    {
        public int Id { get; set; }
        [JsonPropertyName("state_name")]
        public string StateName { get; set; }
    }

    public class CityModel
    {
        public int Id { get; set; }
        [JsonPropertyName("city_name")]
        public string CityName { get; set; }
    }

    // ✅ Updated: Use relative URL for states
    private async Task OnCountryChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int countryId))
        {
            signupModel.Address.Country_Id = countryId;

            if (countryId > 0)
            {
                try
                {
                    var response = await Http.GetFromJsonAsync<ApiResponse<List<StateModel>>>($"listOfState/{countryId}");
                    states = response?.Data?.Select(s => new LocationModel
                        {
                            Id = s.Id,
                            Name = s.StateName
                        }).ToList() ?? new List<LocationModel>();

                    cities.Clear();
                    signupModel.Address.State_Id = 0;
                    signupModel.Address.City_Id = 0;
                }
                catch (Exception ex)
                {
                    Console.WriteLine("Error fetching states: " + ex.Message);
                }
            }
            else
            {
                states.Clear();
                cities.Clear();
            }
        }
    }

    // ✅ Updated: Use relative URL for cities
    private async Task OnStateChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int stateId))
        {
            signupModel.Address.State_Id = stateId;

            if (stateId > 0)
            {
                try
                {
                    var response = await Http.GetFromJsonAsync<ApiResponse<List<CityModel>>>($"listOfCity/{stateId}");
                    cities = response?.Data?.Select(c => new LocationModel
                        {
                            Id = c.Id,
                            Name = c.CityName
                        }).ToList() ?? new List<LocationModel>();

                    signupModel.Address.City_Id = 0;
                }
                catch (Exception ex)
                {
                    Console.WriteLine("Error fetching cities: " + ex.Message);
                }
            }
            else
            {
                cities.Clear();
            }
        }
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
    }

    private async Task HandleSignup()
    {
        if (signupModel.Password != confirmPassword)
        {
            Console.WriteLine("Passwords do not match!");
            return;
        }

        try
        {
            var httpClient = Http;

            if (selectedFile != null)
            {
                using var content = new MultipartFormDataContent();
                using var stream = selectedFile.OpenReadStream(maxAllowedSize: 10_000_000);
                var fileContent = new StreamContent(stream);
                fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(selectedFile.ContentType);

                content.Add(fileContent, "file", selectedFile.Name);

                var uploadResponse = await httpClient.PostAsync("fileUpload", content);
                if (uploadResponse.IsSuccessStatusCode)
                {
                    var uploadedFileName = await uploadResponse.Content.ReadAsStringAsync();
                    signupModel.Profile_Image = uploadedFileName.Replace("\"", "");
                }
                else
                {
                    var error = await uploadResponse.Content.ReadAsStringAsync();
                    Console.WriteLine("File upload failed: " + error);
                    return;
                }
            }

            var registerResponse = await httpClient.PostAsJsonAsync("user/registration", signupModel);

            if (registerResponse.IsSuccessStatusCode)
            {
                NavigationManager.NavigateTo("/login");
            }
            else
            {
                var error = await registerResponse.Content.ReadAsStringAsync();
                Console.WriteLine("Signup failed: " + error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error while signing up: " + ex.Message);
        }
    }
}
