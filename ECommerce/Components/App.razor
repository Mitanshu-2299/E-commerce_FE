<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        @if (routeData.PageType == typeof(ECommerce.Components.Pages.Auth.Login))
        {
            <RouteView RouteData="@routeData" DefaultLayout="@null" />
        }
        else
        {
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(ECommerce.Components.Layout.MainLayout)" />
        }
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(ECommerce.Components.Layout.MainLayout)">
            <p>Sorry, there's nothing at this address.</p>
        </LayoutView>
    </NotFound>
</Router>

<HeadOutlet />
